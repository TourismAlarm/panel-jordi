# Supabase (proyecto «Panel-jordi»)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor: crons, bandeja desde automatizaciones, prueba de RLS

# Acceso: único correo que puede entrar
ALLOWED_EMAIL=basecero5@gmail.com

# Crons (cadena aleatoria de 16+ caracteres). Vercel la manda como «Authorization: Bearer …»
CRON_SECRET=

# IA (Fases 3, 5 y 6)

# Correo (Fases 3, 5 y 6)
RESEND_API_KEY=
RESEND_FROM=

# Finanzas (Fase 2)
IBAN_HASH_SECRET=                 # 16+ caracteres aleatorios: huella de los IBAN (nunca se guarda el IBAN completo)
APP_URL=                          # https://<tu-dominio>: base de la URL de vuelta del banco
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=       # contenido del .pem (saltos de línea como \n)
ENABLE_BANKING_REDIRECT_URL=      # opcional; por defecto APP_URL + /api/finanzas/banking/callback
BANK_OWN_NAMES=                   # opcional: variantes de tu nombre separadas por |

# Bots de Grok Bot: entrada /api/bots/* (ver docs/bots-api.md). 16+ caracteres aleatorios cada una.
BOTS_API_KEY_ANTONIO=             # la de Antonio: con ella entra todo y firma por los demás bots
BOTS_API_KEY_EDITOR=              # la del Editor (el PC o Claude Code): toma, informa y entrega montajes
# Opcionales: si existen, ese bot solo puede firmar como él mismo.
# BOTS_API_KEY_IDEAS=  BOTS_API_KEY_GUIONISTA=  BOTS_API_KEY_DIA=  BOTS_API_KEY_FINANZAS=  BOTS_API_KEY_SALUD=  BOTS_API_KEY_DOCUMENTOS=

# Avisos del panel a Antonio (lib/bots/aviso.ts). Sin ellas, lo que decides no le llega al momento.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
GROKBOT_WEBHOOK_HEADER=           # opcional: «X-Api-Key» o «Authorization: Bearer <clave>» (por defecto)

# Salud (Fase 3): contraseña del proceso del PC para dejar datos en /api/salud/ingesta
SALUD_INGESTA_SECRET=

# Hoy (Fase 5): Gmail + Calendar en solo lectura. Cliente OAuth de Google Cloud (ver README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=                 # 64 caracteres hex (32 bytes): cifra el token de Google. openssl rand -hex 32

