# Supabase (proyecto «Panel-jordi»)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor: crons, bandeja desde automatizaciones, prueba de RLS

# Acceso: único correo que puede entrar
ALLOWED_EMAIL=basecero5@gmail.com

# Crons (cadena aleatoria de 16+ caracteres). Vercel la manda como «Authorization: Bearer …»
CRON_SECRET=

# IA (Fases 3, 5 y 6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Correo (Fases 3, 5 y 6)
RESEND_API_KEY=
RESEND_FROM=

# Finanzas (Fase 2)
IBAN_HASH_SECRET=                 # 16+ caracteres aleatorios: huella de los IBAN (nunca se guarda el IBAN completo)
APP_URL=                          # https://<tu-dominio>: base de la URL de vuelta del banco
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=       # contenido del .pem (saltos de línea como \n)
ENABLE_BANKING_REDIRECT_URL=      # opcional; por defecto APP_URL + /api/finanzas/banking/callback
BANK_OWN_NAMES=                   # opcional: variantes de tu nombre separadas por |

# Salud (Fase 3): contraseña del proceso del PC para dejar datos en /api/salud/ingesta
SALUD_INGESTA_SECRET=

# Hoy (Fase 5): contraseña de la tarea programada de Claude (GET /api/hoy/senales y POST /api/hoy/resumen)
HOY_RESUMEN_SECRET=

# Opcional: conexión directa con Gmail + Calendar en solo lectura (ver README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=                 # 64 caracteres hex (32 bytes): cifra el token de Google. openssl rand -hex 32

# Documentos (Fase 6): contraseña de la tarea de Claude que lee los documentos subidos
DOCS_TAREA_SECRET=
